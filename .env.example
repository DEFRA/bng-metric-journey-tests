# Real Defra ID (GOV.UK One Login) credentials — required only for e2e mode
# (RUN_MODE=e2e). Copy this file to .env for local e2e runs; in CI / on the CDP
# Portal these are injected from the secret store. .env is gitignored — never
# commit real credentials.
# DEFRA_ID_USERNAME is the One Login email address.
DEFRA_ID_USERNAME=
DEFRA_ID_PASSWORD=
# Authenticator-app setup key (base32). Only used if One Login asks for a
# security code — Defra ID dev/test currently sign in with a password alone.
DEFRA_ID_TOTP_SECRET=
